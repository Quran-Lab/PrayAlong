{
  "name": "prayalong",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "PrayAlong — a calm, hands-free Salah companion.",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --threshold error && vite build && node scripts/split-large-assets.mjs",
    "preview": "vite preview",
    "check": "svelte-check",
    "test": "vitest run",
    "test:watch": "vitest",
    "shots": "node scripts/screenshots.mjs",
    "postinstall": "node scripts/copy-mediapipe.mjs",
    "fetch:quran": "node scripts/fetch-quran-translations.mjs",
    "backgrounds": "node scripts/backgrounds.mjs",
    "fetch:asr": "node scripts/fetch-asr.mjs",
    "voice": "python3 tools/voice/render_coach.py"
  },
  "dependencies": {
    "@fontsource-variable/noto-kufi-arabic": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/noto-nastaliq-urdu": "^5.3.0",
    "@lucide/svelte": "^1.52.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@pixiv/three-vrm": "^3.5.5",
    "adhan": "^4.4.6",
    "onnxruntime-web": "^1.30.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "ajv": "^8.20.0",
    "playwright": "^1.63.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
}
